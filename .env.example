# Django API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public site URL used for canonical links, sitemap, robots and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional contact details shown in the header and footer
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, e.g. 8801XXXXXXXXX (enables WhatsApp buttons)
NEXT_PUBLIC_WHATSAPP=
